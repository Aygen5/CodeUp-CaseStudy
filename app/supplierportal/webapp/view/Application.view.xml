<mvc:View
  controllerName="codeup.supplier.portal.controller.Application"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:form="sap.ui.layout.form"
  xmlns:core="sap.ui.core"
  xmlns:u="sap.ui.unified"
  xmlns:unified="sap.ui.unified"
  xmlns:commons="sap.suite.ui.commons"
  height="100%">
  <Page
    id="applicationPage"
    title="{i18n>appPlaceholderTitle}"
    showNavButton="false"
    backgroundDesign="Solid">
    <headerContent>
      <HBox alignItems="Center">
        <Button
          id="btnThemeToggleApp"
          icon="{= ${themeModel>/isDark} ? 'sap-icon://light-mode' : 'sap-icon://dark-mode' }"
          text="{= ${themeModel>/isDark} ? ${i18n>themeMorningHorizon} : ${i18n>themeEveningHorizon} }"
          tooltip="{i18n>themeToggleTooltip}"
          type="Transparent"
          class="sapUiSmallMarginEnd"
          press=".onToggleTheme" />
        <Avatar
          icon="sap-icon://supplier"
          displayShape="Circle"
          displaySize="XS"
          class="sapUiTinyMarginEnd" />
        <Text
          text="{appView>/supplierEmail}"
          class="sapUiSmallMarginEnd" />
        <Button
          id="btnLogout"
          text="{i18n>btnLogout}"
          icon="sap-icon://log-out"
          type="Transparent"
          press=".onLogout" />
      </HBox>
    </headerContent>
    <content>
      <VBox class="sapUiResponsiveMargin">

        <!-- Bilgilendirme Çubuğu (Yalnızca Form Görünürken) -->
        <MessageStrip
          id="formNoticeBar"
          text="{i18n>formNoticeBar}"
          type="Information"
          showIcon="true"
          visible="{= !${appView>/hasExistingSubmission} }"
          class="sapUiSmallMarginBottom" />

        <!-- Hata Bildirimi -->
        <MessageStrip
          id="msgError"
          visible="{appView>/hasError}"
          text="{appView>/errorMessage}"
          type="Error"
          showIcon="true"
          showCloseButton="true"
          close=".onErrorStripClose"
          class="sapUiSmallMarginBottom" />

        <!-- Başarı Bildirimi -->
        <MessageStrip
          id="msgSuccess"
          visible="{appView>/hasSuccess}"
          text="{appView>/successMessage}"
          type="Success"
          showIcon="true"
          class="sapUiSmallMarginBottom" />

        <!-- =================================================================== -->
        <!-- DURUM 1: Mevcut Başvuru Durumu ve 3 Aşamalı ProcessFlow Akışı         -->
        <!-- =================================================================== -->
        <f:Card
          id="existingSubmissionCard"
          width="100%"
          visible="{= ${appView>/hasExistingSubmission} &amp;&amp; !${appView>/isReApplyMode} }">
          <f:header>
            <f:cards.Header
              title="{i18n>processFlowTitle}"
              subtitle="{appView>/existingSubmission/companyName}"
              iconSrc="{appView>/existingSubmission/statusIcon}" />
          </f:header>
          <f:content>
            <VBox class="sapUiMediumMargin">
              <!-- Durum Özel Bilgilendirme Notu -->
              <MessageStrip
                id="statusNoticeStrip"
                text="{appView>/existingSubmission/statusNotice}"
                type="{appView>/existingSubmission/noticeType}"
                showIcon="true"
                class="sapUiSmallMarginBottom" />

              <!-- Reddedilme Durumunda Onaycının Gerçek Karar Notu / Gerekçesi -->
              <MessageStrip
                id="rejectionReasonStrip"
                visible="{= ${appView>/existingSubmission/status} === 'Rejected' &amp;&amp; !!${appView>/existingSubmission/rejectionReason} }"
                text="{i18n>rejectionBannerTitle}: {appView>/existingSubmission/rejectionReason}"
                type="Error"
                showIcon="true"
                class="sapUiSmallMarginBottom" />

              <!-- Başvuru Temel Özeti -->
              <HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMarginEnd">
                  <Text text="{i18n>companyNameLabel}" />
                  <Title text="{appView>/existingSubmission/companyName}" level="H3" titleStyle="H4" />
                </VBox>
                <VBox class="sapUiSmallMarginEnd">
                  <Text text="{i18n>contactPersonLabel}" />
                  <Text text="{appView>/existingSubmission/contactPerson}" />
                </VBox>
                <VBox class="sapUiSmallMarginEnd">
                  <Text text="{i18n>categoryLabel}" />
                  <Text text="{appView>/existingSubmission/category}" />
                </VBox>
                <VBox class="sapUiSmallMarginEnd">
                  <Text text="{i18n>existingSubmissionDate}" />
                  <Text text="{appView>/existingSubmission/submissionDate}" />
                </VBox>
                <VBox>
                  <Text text="{i18n>existingStatusLabel}" />
                  <ObjectStatus
                    id="existingStatusBadge"
                    text="{appView>/existingSubmission/statusText}"
                    state="{appView>/existingSubmission/statusState}"
                    icon="{appView>/existingSubmission/statusIcon}" />
                </VBox>
              </HBox>

              <!-- 3 Aşamalı SAPUI5 ProcessFlow Akışı -->
              <Panel headerText="{i18n>processFlowTitle}" expandable="false" class="sapUiSmallMarginBottom">
                <commons:ProcessFlow
                  id="processFlow"
                  scrollable="false"
                  foldedCorners="true"
                  nodes="{appView>/processFlow/nodes}"
                  lanes="{appView>/processFlow/lanes}">
                  <commons:nodes>
                    <commons:ProcessFlowNode
                      nodeId="{appView>id}"
                      laneId="{appView>lane}"
                      title="{appView>title}"
                      titleAbbreviation="{appView>titleAbbreviation}"
                      state="{appView>state}"
                      stateText="{appView>stateText}"
                      texts="{appView>texts}"
                      children="{appView>children}"
                      highlighted="{appView>highlighted}" />
                  </commons:nodes>
                  <commons:lanes>
                    <commons:ProcessFlowLaneHeader
                      laneId="{appView>id}"
                      iconSrc="{appView>icon}"
                      text="{appView>label}"
                      position="{appView>position}"
                      state="{appView>state}" />
                  </commons:lanes>
                </commons:ProcessFlow>
              </Panel>

              <HBox justifyContent="End" class="sapUiSmallMarginTop">
                <Button
                  id="btnRefreshProcess"
                  text="{i18n>btnRefreshProcessFlow}"
                  icon="sap-icon://refresh"
                  type="Transparent"
                  class="sapUiSmallMarginEnd"
                  press=".onRefreshStatus" />
                <Button
                  id="btnReApply"
                  text="{i18n>reApplyButton}"
                  icon="sap-icon://edit"
                  type="Emphasized"
                  visible="{= ${appView>/existingSubmission/status} === 'Rejected' }"
                  press=".onOpenReApply" />
              </HBox>
            </VBox>
          </f:content>
        </f:Card>

        <!-- =================================================================== -->
        <!-- DURUM 2: Korumalı Yeniden Başvuru Formu (Re-apply)                  -->
        <!-- =================================================================== -->
        <f:Card
          id="reApplyCard"
          width="100%"
          visible="{appView>/isReApplyMode}">
          <f:header>
            <f:cards.Header
              title="{i18n>reApplyTitle}"
              subtitle="{appView>/existingSubmission/companyName}"
              iconSrc="sap-icon://edit" />
          </f:header>
          <f:content>
            <VBox class="sapUiMediumMargin">
              <!-- Onaycının Red Gerekçesi -->
              <MessageStrip
                id="reApplyRejectionStrip"
                text="{i18n>rejectionBannerTitle}: {appView>/existingSubmission/rejectionReason}"
                type="Error"
                showIcon="true"
                class="sapUiSmallMarginBottom" />

              <!-- Düzenlenebilir Alanlar Bilgilendirmesi -->
              <MessageStrip
                id="reApplyNoticeStrip"
                text="{i18n>reApplyNotice} ({i18n>editableFieldsLabel} {appView>/reApplyEditableLabels})"
                type="Information"
                showIcon="true"
                class="sapUiSmallMarginBottom" />

              <form:SimpleForm
                id="reApplyForm"
                editable="true"
                layout="ResponsiveGridLayout"
                title="{i18n>reApplyTitle}"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="2"
                columnsL="2"
                columnsM="2"
                singleContainerFullSize="false">
                <form:content>
                  <!-- 1. GRUP: Kurumsal Şirket Bilgileri -->
                  <core:Title text="{i18n>groupCompanyInfo}" />

                  <Label
                    text="{i18n>companyNameLabel}"
                    required="{appView>/editableFields/companyName}" />
                  <Input
                    id="reApplyCompanyNameInput"
                    value="{appView>/reApplyFormData/companyName}"
                    editable="{appView>/editableFields/companyName}"
                    tooltip="{= ${appView>/editableFields/companyName} ? ${i18n>editableFieldTooltip} : ${i18n>lockedFieldTooltip} }"
                    change=".onInputChange" />

                  <Label
                    text="{i18n>contactPersonLabel}"
                    required="{appView>/editableFields/contactPerson}" />
                  <Input
                    id="reApplyContactPersonInput"
                    value="{appView>/reApplyFormData/contactPerson}"
                    editable="{appView>/editableFields/contactPerson}"
                    tooltip="{= ${appView>/editableFields/contactPerson} ? ${i18n>editableFieldTooltip} : ${i18n>lockedFieldTooltip} }"
                    change=".onInputChange" />

                  <Label text="{i18n>emailLabel}" />
                  <Input
                    id="reApplyEmailInput"
                    value="{appView>/supplierEmail}"
                    editable="false"
                    tooltip="{i18n>lockedFieldTooltip}" />

                  <Label text="{i18n>phoneLabel}" />
                  <Input
                    id="reApplyPhoneInput"
                    value="{appView>/reApplyFormData/phone}"
                    editable="{appView>/editableFields/phone}"
                    tooltip="{= ${appView>/editableFields/phone} ? ${i18n>editableFieldTooltip} : ${i18n>lockedFieldTooltip} }"
                    change=".onInputChange" />

                  <Label text="{i18n>countryLabel}" />
                  <Input
                    id="reApplyCountryInput"
                    value="{appView>/reApplyFormData/country}"
                    editable="{appView>/editableFields/country}"
                    tooltip="{= ${appView>/editableFields/country} ? ${i18n>editableFieldTooltip} : ${i18n>lockedFieldTooltip} }"
                    change=".onInputChange" />

                  <Label text="{i18n>categoryLabel}" />
                  <Select
                    id="reApplyCategorySelect"
                    selectedKey="{appView>/reApplyFormData/category}"
                    enabled="{appView>/editableFields/category}"
                    tooltip="{= ${appView>/editableFields/category} ? ${i18n>editableFieldTooltip} : ${i18n>lockedFieldTooltip} }"
                    change=".onInputChange"
                    width="100%">
                    <core:Item key="" text="{i18n>selectCategoryPrompt}" />
                    <core:Item key="Hardware" text="{i18n>categoryHardware}" />
                    <core:Item key="Software" text="{i18n>categorySoftware}" />
                    <core:Item key="Services" text="{i18n>categoryServices}" />
                    <core:Item key="Consulting" text="{i18n>categoryConsulting}" />
                  </Select>

                  <Label text="{i18n>taxIdLabel}" />
                  <Input
                    id="reApplyTaxIdInput"
                    value="{appView>/reApplyFormData/taxId}"
                    editable="{appView>/editableFields/taxId}"
                    tooltip="{= ${appView>/editableFields/taxId} ? ${i18n>editableFieldTooltip} : ${i18n>lockedFieldTooltip} }"
                    change=".onInputChange" />

                  <Label text="{i18n>websiteLabel}" />
                  <Input
                    id="reApplyWebsiteInput"
                    value="{appView>/reApplyFormData/website}"
                    editable="{appView>/editableFields/website}"
                    tooltip="{= ${appView>/editableFields/website} ? ${i18n>editableFieldTooltip} : ${i18n>lockedFieldTooltip} }"
                    change=".onInputChange" />

                  <Label text="{i18n>addressLabel}" />
                  <TextArea
                    id="reApplyAddressInput"
                    value="{appView>/reApplyFormData/address}"
                    editable="{appView>/editableFields/address}"
                    tooltip="{= ${appView>/editableFields/address} ? ${i18n>editableFieldTooltip} : ${i18n>lockedFieldTooltip} }"
                    rows="3"
                    growing="true"
                    growingMaxLines="5"
                    change=".onInputChange" />

                  <Label text="{i18n>notesLabel}" />
                  <TextArea
                    id="reApplyNotesInput"
                    value="{appView>/reApplyFormData/notes}"
                    editable="{appView>/editableFields/notes}"
                    tooltip="{= ${appView>/editableFields/notes} ? ${i18n>editableFieldTooltip} : ${i18n>lockedFieldTooltip} }"
                    rows="3"
                    growing="true"
                    growingMaxLines="5"
                    change=".onInputChange" />

                  <!-- 2. GRUP: Sertifika Belgesi -->
                  <core:Title text="{i18n>groupCertificateInfo}" />

                  <Label text="{i18n>certificateLabel}" />
                  <VBox>
                    <Text
                      text="{= ${appView>/editableFields/certificate} ? ${i18n>reApplyCertificateOptional} : ${i18n>reApplyCertificateLocked} }"
                      class="sapUiTinyMarginBottom" />

                    <u:FileUploader
                      id="reApplyFileUploader"
                      name="reApplyCertificateUpload"
                      fileType="pdf"
                      mimeType="application/pdf"
                      uploadOnChange="false"
                      buttonOnly="false"
                      buttonText="{i18n>fileUploadButtonText}"
                      placeholder="{i18n>fileUploadPrompt}"
                      enabled="{appView>/editableFields/certificate}"
                      tooltip="{= ${appView>/editableFields/certificate} ? ${i18n>editableFieldTooltip} : ${i18n>lockedFieldTooltip} }"
                      change=".onReApplyFileChange"
                      width="100%" />

                    <HBox
                      alignItems="Center"
                      visible="{appView>/reApplyCertificate/hasFile}"
                      class="sapUiTinyMarginTop">
                      <ObjectStatus
                        id="reApplyCertStatusBadge"
                        text="{appView>/reApplyCertificate/fileName} ({appView>/reApplyCertificate/fileSizeFormatted})"
                        state="{appView>/reApplyCertificate/statusState}"
                        icon="{appView>/reApplyCertificate/statusIcon}" />
                    </HBox>
                  </VBox>
                </form:content>
              </form:SimpleForm>

              <HBox justifyContent="End" class="sapUiSmallMarginTop">
                <Button
                  id="btnCancelReApply"
                  text="{i18n>reApplyCancelButton}"
                  icon="sap-icon://decline"
                  type="Transparent"
                  class="sapUiSmallMarginEnd"
                  press=".onCancelReApply" />
                <Button
                  id="btnSubmitReApply"
                  text="{i18n>reApplySubmitButton}"
                  icon="sap-icon://paper-plane"
                  type="Emphasized"
                  busy="{appView>/isBusy}"
                  press=".onReApplySubmit" />
              </HBox>
            </VBox>
          </f:content>
        </f:Card>

        <!-- =================================================================== -->
        <!-- DURUM 3: İlk Başvuru Formu (Gruplandırılmış SimpleForm)             -->
        <!-- =================================================================== -->
        <f:Card
          id="newApplicationCard"
          width="100%"
          visible="{= !${appView>/hasExistingSubmission} &amp;&amp; !${appView>/isReApplyMode} }">
          <f:content>
            <VBox class="sapUiMediumMargin">
              <form:SimpleForm
                id="applicationForm"
                editable="true"
                layout="ResponsiveGridLayout"
                title="{i18n>formTitle}"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="2"
                columnsL="2"
                columnsM="2"
                singleContainerFullSize="false">
                <form:content>
                  <!-- 1. GRUP: Kurumsal Şirket Bilgileri -->
                  <core:Title text="{i18n>groupCompanyInfo}" />

                  <Label
                    text="{i18n>companyNameLabel}"
                    required="true"
                    labelFor="inpCompanyName" />
                  <Input
                    id="inpCompanyName"
                    value="{appView>/formData/companyName}"
                    placeholder="{i18n>companyNamePlaceholder}"
                    valueLiveUpdate="true"
                    liveChange=".onInputChange" />

                  <Label
                    text="{i18n>contactPersonLabel}"
                    required="true"
                    labelFor="inpContactPerson" />
                  <Input
                    id="inpContactPerson"
                    value="{appView>/formData/contactPerson}"
                    placeholder="{i18n>contactPersonPlaceholder}"
                    valueLiveUpdate="true"
                    liveChange=".onInputChange" />

                  <Label
                    text="{i18n>emailLabel}"
                    labelFor="inpEmail" />
                  <Input
                    id="inpEmail"
                    value="{appView>/supplierEmail}"
                    editable="false" />

                  <Label
                    text="{i18n>phoneLabel}"
                    labelFor="inpPhone" />
                  <Input
                    id="inpPhone"
                    value="{appView>/formData/phone}"
                    type="Tel"
                    placeholder="{i18n>phonePlaceholder}" />

                  <Label
                    text="{i18n>countryLabel}"
                    labelFor="inpCountry" />
                  <Input
                    id="inpCountry"
                    value="{appView>/formData/country}"
                    placeholder="{i18n>countryPlaceholder}" />

                  <Label
                    text="{i18n>categoryLabel}"
                    labelFor="selCategory" />
                  <Select
                    id="selCategory"
                    selectedKey="{appView>/formData/category}"
                    width="100%">
                    <core:Item key="" text="{i18n>selectCategoryPrompt}" />
                    <core:Item key="Hardware" text="{i18n>categoryHardware}" />
                    <core:Item key="Software" text="{i18n>categorySoftware}" />
                    <core:Item key="Services" text="{i18n>categoryServices}" />
                    <core:Item key="Consulting" text="{i18n>categoryConsulting}" />
                  </Select>

                  <Label
                    text="{i18n>taxIdLabel}"
                    labelFor="inpTaxId" />
                  <Input
                    id="inpTaxId"
                    value="{appView>/formData/taxId}"
                    placeholder="{i18n>taxIdPlaceholder}" />

                  <Label
                    text="{i18n>websiteLabel}"
                    labelFor="inpWebsite" />
                  <Input
                    id="inpWebsite"
                    value="{appView>/formData/website}"
                    type="Url"
                    placeholder="{i18n>websitePlaceholder}" />

                  <Label
                    text="{i18n>addressLabel}"
                    labelFor="inpAddress" />
                  <TextArea
                    id="inpAddress"
                    value="{appView>/formData/address}"
                    placeholder="{i18n>addressPlaceholder}"
                    rows="2"
                    width="100%" />

                  <Label
                    text="{i18n>notesLabel}"
                    labelFor="inpNotes" />
                  <TextArea
                    id="inpNotes"
                    value="{appView>/formData/notes}"
                    placeholder="{i18n>notesPlaceholder}"
                    rows="2"
                    width="100%" />

                  <!-- 2. GRUP: Kalite / Yetki Sertifikası (PDF) -->
                  <core:Title text="{i18n>groupCertificateInfo}" />

                  <Label
                    text="{i18n>certificateLabel}"
                    required="true"
                    labelFor="fileUploader" />
                  <VBox width="100%">
                    <MessageStrip
                      text="{i18n>certificateHint}"
                      type="Information"
                      showIcon="true"
                      class="sapUiTinyMarginBottom" />

                    <u:FileUploader
                      id="fileUploader"
                      name="certificateFile"
                      fileType="pdf"
                      mimeType="application/pdf"
                      buttonText="{i18n>fileUploadButtonText}"
                      placeholder="{i18n>fileUploadPrompt}"
                      width="100%"
                      sameFilenameAllowed="true"
                      change=".onFileChange"
                      class="sapUiTinyMarginBottom" />

                    <!-- Dosya Durumu Göstergesi -->
                    <HBox
                      alignItems="Center"
                      visible="{appView>/certificate/hasFile}"
                      class="sapUiTinyMarginTop">
                      <ObjectStatus
                        id="fileStatusBadge"
                        text="{appView>/certificate/fileName}"
                        state="{appView>/certificate/statusState}"
                        icon="{appView>/certificate/statusIcon}"
                        class="sapUiSmallMarginEnd" />
                      <Text text="{i18n>fileSizeText} {appView>/certificate/fileSizeFormatted}" />
                    </HBox>
                  </VBox>
                </form:content>
              </form:SimpleForm>

              <!-- Gönderim Butonu ve İşlem Çubuğu -->
              <Toolbar class="sapUiSmallMarginTop">
                <ToolbarSpacer />
                <Button
                  id="btnSubmitSubmission"
                  text="{i18n>submitButton}"
                  type="Emphasized"
                  icon="sap-icon://paper-plane"
                  press=".onSubmit"
                  busy="{appView>/isBusy}" />
              </Toolbar>
            </VBox>
          </f:content>
        </f:Card>

      </VBox>
    </content>
  </Page>
</mvc:View>

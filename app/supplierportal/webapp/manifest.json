{
  "_version": "1.59.0",
  "sap.app": {
    "id": "codeup.supplier.portal",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    },
    "supportedThemes": [
      "sap_horizon",
      "sap_horizon_dark"
    ]
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "codeup.supplier.portal.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.f": {},
        "sap.ui.unified": {},
        "sap.suite.ui.commons": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "codeup.supplier.portal.i18n.i18n",
          "supportedLocales": [
            "",
            "tr",
            "en"
          ],
          "fallbackLocale": "en"
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "codeup.supplier.portal.view",
        "controlId": "appControl",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "name": "auth",
          "pattern": "",
          "target": "auth"
        },
        {
          "name": "application",
          "pattern": "application",
          "target": "application"
        },
        {
          "name": "main",
          "pattern": "welcome",
          "target": "main"
        }
      ],
      "targets": {
        "auth": {
          "viewName": "Auth",
          "viewId": "auth",
          "viewLevel": 1
        },
        "application": {
          "viewName": "Application",
          "viewId": "application",
          "viewLevel": 2
        },
        "main": {
          "viewName": "Main",
          "viewId": "main",
          "viewLevel": 1
        }
      }
    }
  }
}

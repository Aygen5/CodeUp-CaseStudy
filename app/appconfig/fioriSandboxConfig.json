{
  "applications": {
    "SupplierPortal-display": {
      "title": "Supplier Portal",
      "description": "Supplier Onboarding & Application",
      "additionalInformation": "SAPUI5.Component=codeup.supplier.portal",
      "applicationType": "URL",
      "url": "/supplierportal",
      "navigationMode": "embedded"
    },
    "SupplierApprovals-manage": {
      "title": "Supplier Approvals",
      "description": "Application Review & AI Analysis",
      "additionalInformation": "SAPUI5.Component=codeup.supplier.approvals",
      "applicationType": "URL",
      "url": "/supplier-approvals",
      "navigationMode": "embedded"
    }
  },
  "services": {
    "LaunchPageAdapter": {
      "config": {
        "groups": [
          {
            "id": "codeup_supplier_management",
            "title": "CodeUp Supplier Management",
            "isPreset": true,
            "isVisible": true,
            "isGroupLocked": false,
            "tiles": [
              {
                "id": "tile_supplier_portal",
                "title": "Supplier Portal",
                "size": "1x1",
                "tileType": "sap.ushell.ui.tile.StaticTile",
                "properties": {
                  "title": "Supplier Portal",
                  "subtitle": "Supplier Onboarding & Application",
                  "info": "Self-Service",
                  "icon": "sap-icon://supplier",
                  "targetURL": "#SupplierPortal-display"
                }
              },
              {
                "id": "tile_supplier_approvals",
                "title": "Supplier Approvals",
                "size": "1x1",
                "tileType": "sap.ushell.ui.tile.StaticTile",
                "properties": {
                  "title": "Supplier Approvals",
                  "subtitle": "Application Review & AI Analysis",
                  "info": "Approval Cockpit",
                  "icon": "sap-icon://approvals",
                  "targetURL": "#SupplierApprovals-manage"
                }
              }
            ]
          }
        ]
      }
    },
    "NavTargetResolution": {
      "config": {
        "enableClientSideTargetResolution": true
      }
    }
  }
}

{
  "name": "codeup-supplier-management",
  "version": "1.0.0",
  "description": "Supplier Management — Tedarikçi Onboarding & Onay (CodeUp Case Study)",
  "repository": "https://github.com/Aygen5/CodeUp-CaseStudy.git",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^1.9.2",
    "@sap/approuter": "^23.0.0",
    "@sap/cds": "^8",
    "@sap/hana-client": "^2.29.27",
    "@sap/xsenv": "^5",
    "@sap/xssec": "^4",
    "bcryptjs": "^3.0.3",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^9.9.6"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "approuter": "node approuter.js",
    "deploy:hana": "cds deploy --to hana"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite"
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "approver": {
            "roles": [
              "Approval"
            ]
          },
          "unauthorized_user": {
            "roles": [
              "StandardUser"
            ]
          }
        }
      },
      "gemini": {
        "kind": "rest",
        "credentials": {
          "destination": "gemini",
          "requestTimeout": 60000
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "xsuaa"
        }
      },
      "[hybrid]": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "xsuaa"
        }
      }
    },
    "server": {
      "body_parser": {
        "limit": "20mb"
      }
    }
  }
}

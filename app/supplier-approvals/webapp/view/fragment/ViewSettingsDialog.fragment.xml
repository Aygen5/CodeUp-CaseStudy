<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">
    <ViewSettingsDialog
        id="viewSettingsDialog"
        confirm=".onConfirmViewSettings"
        resetFilters=".onResetViewSettings">
        <sortItems>
            <ViewSettingsItem
                text="{i18n>colDate}"
                key="submissionDate"
                selected="true" />
            <ViewSettingsItem
                text="{i18n>colCompany}"
                key="companyName" />
            <ViewSettingsItem
                text="{i18n>colStatus}"
                key="status" />
        </sortItems>
        <filterItems>
            <ViewSettingsFilterItem
                text="{i18n>colCategory}"
                key="category"
                multiSelect="false">
                <items>
                    <ViewSettingsItem text="Hardware" key="Hardware" />
                    <ViewSettingsItem text="Software" key="Software" />
                    <ViewSettingsItem text="Services" key="Services" />
                    <ViewSettingsItem text="Consulting" key="Consulting" />
                </items>
            </ViewSettingsFilterItem>
        </filterItems>
        <customTabs>
            <ViewSettingsCustomTab
                id="columnsTab"
                title="{i18n>settingsColumnsTab}">
                <content>
                    <VBox class="sapUiSmallMargin">
                        <CheckBox
                            text="{i18n>colCompany}"
                            selected="{viewSettingsModel>/companyName}" />
                        <CheckBox
                            text="{i18n>colContact}"
                            selected="{viewSettingsModel>/contactPerson}" />
                        <CheckBox
                            text="{i18n>colEmail}"
                            selected="{viewSettingsModel>/supplierEmail}" />
                        <CheckBox
                            text="{i18n>colDate}"
                            selected="{viewSettingsModel>/submissionDate}" />
                        <CheckBox
                            text="{i18n>colStatus}"
                            selected="{viewSettingsModel>/status}" />
                        <CheckBox
                            text="{i18n>colPhone}"
                            selected="{viewSettingsModel>/phone}" />
                        <CheckBox
                            text="{i18n>colCountry}"
                            selected="{viewSettingsModel>/country}" />
                        <CheckBox
                            text="{i18n>colCategory}"
                            selected="{viewSettingsModel>/category}" />
                        <CheckBox
                            text="{i18n>colTaxId}"
                            selected="{viewSettingsModel>/taxId}" />
                        <CheckBox
                            text="{i18n>colWebsite}"
                            selected="{viewSettingsModel>/website}" />
                        <CheckBox
                            text="{i18n>colAddress}"
                            selected="{viewSettingsModel>/address}" />
                        <CheckBox
                            text="{i18n>colNotes}"
                            selected="{viewSettingsModel>/notes}" />
                    </VBox>
                </content>
            </ViewSettingsCustomTab>
        </customTabs>
    </ViewSettingsDialog>
</core:FragmentDefinition>
